# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=3000
APP_SECRET=please-change-me-to-a-long-random-string-at-least-64-chars

# --- Database ---
# Override for production. docker-compose provides a local one.
DATABASE_URL=postgres://openaccounting:openaccounting@localhost:5432/openaccounting

# --- Storage ---
# Where uploaded documents (receipts, invoices) are stored on disk
DOCUMENTS_DIR=./data/documents

# --- Logging ---
RUST_LOG=info,openaccounting=debug,sqlx=warn

# --- Backups (see docs/backup-restore.md) ---
# BACKUP_CRON="0 0 2 * * * *"
# BACKUP_KEEP=7
# BACKUP_DIR=./data/backups
# S3 target (requires STORAGE_BACKEND=s3):
# BACKUP_TARGET=s3
# BACKUP_S3_PREFIX=backups

# --- Rate limits per minute per IP (see src/ratelimit.rs) ---
# AUTH_RATE_LIMIT_PER_MIN=60
# API_IP_RATE_LIMIT_PER_MIN=600
# WEBHOOK_RATE_LIMIT_PER_MIN=120
# IMPORT_RATE_LIMIT_PER_MIN=60

# --- Tracing (opt-in OTel, see docs/threat-model.md) ---
# TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
